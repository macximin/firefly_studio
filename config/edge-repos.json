{
  "schemaVersion": 2,
  "family": "firefly-studio",
  "restoreRoot": "edge_repos",
  "policy": {
    "role": "thin-longform-production-hq",
    "routingInputs": [
      "firefly_market_radar",
      "firefly_reference_lab"
    ],
    "defaultProductionEngine": "inkos",
    "noAutomaticWriteback": true,
    "manifestIsScopeAuthority": true
  },
  "repos": [
    {
      "name": "inkos",
      "displayName": "InkOS Engine",
      "path": "edge_repos/inkos",
      "remoteUrl": "git@github.com:macximin/inkos.git",
      "upstreamUrl": "https://github.com/Narcooo/inkos.git",
      "branch": "master",
      "managementState": "active",
      "adoptionState": "ready",
      "pullAllowed": true,
      "writeAllowed": true,
      "role": "production engine for long fiction, short fiction, scripts, interactive narrative, Arc and Rail state",
      "execution": {
        "kind": "worker",
        "adapter": "inkos-cli-dual",
        "entrypoint": "packages/cli/dist/index.js",
        "receiptContract": "run-receipt/dual",
        "writeScopes": [
          "books/",
          ".inkos/"
        ],
        "observationScopes": [
          "books/",
          ".inkos/",
          "worlds/",
          "interactive-films/",
          "inkos.json"
        ],
        "capabilities": [
          {
            "name": "status",
            "mode": "read-only",
            "approval": "none"
          },
          {
            "name": "interact",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "write-next",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "reference-bind",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "pitch-slate",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "pitch-review",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "pitch-decision",
            "mode": "mutating",
            "approval": "human"
          },
          {
            "name": "pitch-promote",
            "mode": "mutating",
            "approval": "human"
          }
        ]
      }
    },
    {
      "name": "firefly_reference_lab",
      "displayName": "Firefly Reference Lab",
      "path": "edge_repos/firefly_reference_lab",
      "remoteUrl": "git@github.com:macximin/firefly_reference_lab.git",
      "branch": "main",
      "managementState": "active",
      "adoptionState": "ready",
      "pullAllowed": true,
      "writeAllowed": true,
      "role": "derived pitches, character cores, Arc, event, reward and Gold routing references",
      "execution": {
        "kind": "library",
        "capabilities": []
      }
    },
    {
      "name": "firefly_market_radar",
      "displayName": "Firefly Market Radar",
      "path": "edge_repos/firefly_market_radar",
      "remoteUrl": "git@github.com:macximin/firefly_market_radar.git",
      "branch": "main",
      "managementState": "active",
      "adoptionState": "ready",
      "pullAllowed": true,
      "writeAllowed": true,
      "role": "dated public-metadata market evidence, demand signals and reviewed market briefs",
      "execution": {
        "kind": "tool",
        "capabilities": []
      }
    },
    {
      "name": "storyyard",
      "displayName": "Storyyard Review Surface",
      "path": "edge_repos/storyyard",
      "remoteUrl": "git@github.com:macximin/storyyard.git",
      "branch": "main",
      "managementState": "active",
      "adoptionState": "ready",
      "pullAllowed": true,
      "writeAllowed": true,
      "role": "private mobile human-review projection, decision receipts, and approved publication snapshots",
      "execution": {
        "kind": "tool",
        "capabilities": []
      }
    }
  ],
  "excluded": [
    "shortform_hq and all shortform children",
    "v3_ff_command_center",
    "v3_ff_sources",
    "v3_ff_foundry"
  ]
}
