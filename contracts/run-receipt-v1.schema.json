{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefly.local/contracts/run-receipt-v1.schema.json",
  "title": "Firefly HQ RunReceipt v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "receiptId",
    "workOrderId",
    "workOrderSha256",
    "idempotencyKey",
    "repo",
    "capability",
    "status",
    "mutating",
    "startedAt",
    "approval",
    "inputVerification",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": "string", "minLength": 1 },
    "workOrderSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "status": { "enum": ["running", "succeeded", "failed", "needs-attention"] },
    "mutating": { "type": "boolean" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "approval": {
      "type": "object",
      "required": ["required", "status"],
      "properties": {
        "required": { "type": "boolean" },
        "status": { "enum": ["not-required", "pending", "blocked"] }
      }
    },
    "inputVerification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commit", "path", "sha256", "role", "status"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "status": { "const": "verified" }
        }
      }
    },
    "privateInputVerification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "path", "sha256", "role", "declaredByRole", "status"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "declaredByRole": { "type": "string", "minLength": 1 },
          "status": { "const": "verified" }
        }
      }
    },
    "referenceProvenance": {
      "type": ["object", "null"],
      "properties": {
        "referencePackId": { "type": ["string", "null"] },
        "spineReference": { "type": ["string", "null"] },
        "transformationCreated": { "type": ["boolean", "null"] },
        "railCreated": { "type": ["boolean", "null"] },
        "transformationSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "railPlanSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "arcId": { "type": ["string", "null"] }
      }
    },
    "observedWrites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change", "beforeSha256", "afterSha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "change": { "enum": ["created", "modified", "deleted"] },
          "beforeSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "afterSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "artifactEvidence": {
      "enum": [
        "invalid-child-report",
        "child-reported",
        "dispatcher-observed",
        "dispatcher-observed-no-change",
        "not-reported-by-child"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "path", "sha256", "role"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
