{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefly.local/contracts/work-order-v1.schema.json",
  "title": "Firefly HQ WorkOrder v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workOrderId",
    "idempotencyKey",
    "repo",
    "capability",
    "approvalMode",
    "approvedInputs",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workOrderId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 240 },
    "repo": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "bookId": { "type": "string", "minLength": 1 },
    "slateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "outputSlateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "candidateCount": { "type": "integer", "minimum": 1, "maximum": 20 },
    "planningMode": { "enum": ["general", "source-first"] },
    "candidateId": { "type": "string", "pattern": "^p[0-9]{2}$" },
    "humanDecision": { "enum": ["select", "hold", "reject"] },
    "comment": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "instruction": { "type": "string", "minLength": 1 },
    "approvalMode": { "enum": ["none", "human"] },
    "approvedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commit", "path", "sha256", "role"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "privateInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "path", "sha256", "role", "declaredByRole"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "declaredByRole": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
  },
  "allOf": [
    {
      "if": { "required": ["planningMode"] },
      "then": { "properties": { "capability": { "const": "pitch-slate" } } }
    },
    {
      "if": { "required": ["planningMode"], "properties": { "planningMode": { "const": "source-first" } } },
      "then": {
        "properties": {
          "approvedInputs": {
            "contains": { "required": ["role"], "properties": { "role": { "const": "pitch-source-pack" } } },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "capability": { "const": "pitch-slate" } }, "not": { "required": ["planningMode"], "properties": { "planningMode": { "const": "source-first" } } } },
      "then": { "properties": { "approvedInputs": { "not": { "contains": { "required": ["role"], "properties": { "role": { "const": "pitch-source-pack" } } } } } } }
    }
  ]
}
