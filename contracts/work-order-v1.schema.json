{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefly.local/contracts/work-order-v1.schema.json",
  "title": "Firefly HQ WorkOrder v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workOrderId",
    "idempotencyKey",
    "repo",
    "capability",
    "approvalMode",
    "approvedInputs",
    "requestedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workOrderId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 240 },
    "repo": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "minLength": 1 },
    "bookId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "instruction": { "type": "string", "minLength": 1 },
    "approvalMode": { "enum": ["none", "human"] },
    "approvedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "commit", "path", "sha256", "role"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "privateInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "path", "sha256", "role", "declaredByRole"],
        "properties": {
          "repo": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "type": "string", "minLength": 1 },
          "declaredByRole": { "type": "string", "minLength": 1 }
        }
      },
      "default": []
    },
    "requestedAt": { "type": "string", "format": "date-time" },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
  }
}
