{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firefly.local/contracts/firefly-review-decision-v1.schema.json",
  "title": "Firefly Review Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionId",
    "packetId",
    "packetSha256",
    "workId",
    "artifactId",
    "candidateId",
    "candidateSha256",
    "decision",
    "comment",
    "status",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "firefly_review_decision/v1" },
    "decisionId": { "type": "string", "minLength": 1 },
    "packetId": { "type": "string", "pattern": "^frp-[0-9a-f]{24}$" },
    "packetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workId": { "type": "string", "minLength": 1 },
    "artifactId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "candidateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "enum": ["approve", "polish", "hold", "reject"] },
    "comment": { "type": "string", "maxLength": 2000 },
    "status": { "enum": ["pending", "applied", "superseded", "failed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "appliedAt": { "type": ["string", "null"], "format": "date-time" },
    "applyReceiptPath": { "type": ["string", "null"] },
    "result": {}
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "applied" } }, "required": ["status"] },
      "then": {
        "required": ["appliedAt", "applyReceiptPath", "result"],
        "properties": {
          "appliedAt": { "type": "string", "format": "date-time" },
          "applyReceiptPath": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
